# ─── PostgreSQL (Supabase) ────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_aqui
POSTGRES_DB=postgres
POSTGRES_HOST=db.dxyhlcstwtpyegukdbqc.supabase.co
POSTGRES_PORT=5432

# ─── JWT ──────────────────────────────────────────────
SECRET_KEY=troque_por_uma_chave_secreta_forte_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── ANEEL ────────────────────────────────────────────
ANEEL_RESOURCE_ID=476d0490-a225-4de7-89a8-bb7a189f0868

# ─── LLM / RAG (OpenRouter + Gemini) ──────────────────
OPENROUTER_API_KEY=sua_chave_openrouter_aqui
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash

# ─── RAG (base de conhecimento do agente) ─────────────
CHROMA_PERSIST_DIR=rag_module/vectorstore
DOCUMENTS_DIR=rag_module/documents

# ─── Forzy Sensor API ──────────────────────────────────
FORZY_API_BASE_URL=http://localhost:8000
# URL do túnel (ngrok/cloudflare) até o hardware Forzy — muda a cada sessão
# de coleta, pegue a atual com quem estiver com o sensor físico.
FORZY_SENSOR_URL=https://troque-pela-url-do-tunel-atual.trycloudflare.com

# "real" consulta o hardware Forzy (poll_loop); "demo" repete o histórico
# real capturado em vez de consultar o hardware — usar quando o sensor físico
# estiver indisponível ou devolvendo dado zerado (ver README, "Modo demonstração").
SENSOR_MODE=real

# Quando true, esta instância não roda nenhum processo em background que
# escreve no banco (poller/demo nem o scheduler de diagnóstico) — só serve a
# API pra leitura. Uso: duas instâncias no mesmo banco, uma alimentando
# (SENSOR_MODE=demo) e outra só exibindo (READ_ONLY=true) — ver README.
READ_ONLY=false
